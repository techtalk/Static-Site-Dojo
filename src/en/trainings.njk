---
layout: layout.njk
pagination:
  data: trainings
  size: 1
  alias: training
permalink: "/en/trainings/{{ training.id }}/index.html"
lang: en
---

<a href="/{{ lang }}/categories/" class="back-link">← {{ i18n[lang].back_to_categories }}</a>

<div class="training-detail">
    <h1>{{ training.title[lang] }}</h1>
    
    <div class="training-meta">
        <span class="meta-item">⏱️ {{ i18n[lang].duration }}: {{ training.duration[lang] }}</span>
        <span class="meta-item">📊 {{ i18n[lang].level }}: {{ training.level[lang] }}</span>
        <span class="meta-item">👨‍🏫 {{ i18n[lang].instructor }}: {{ training.instructor[lang] }}</span>
    </div>
    
    <div class="categories-list">
        {% for categoryId in training.categories %}
            {% for cat in categories %}
                {% if cat.id == categoryId %}
                    <a href="/{{ lang }}/categories/{{ categoryId }}/" class="category-badge">{{ cat.name[lang] }}</a>
                {% endif %}
            {% endfor %}
        {% endfor %}
    </div>
    
    <h2>{{ i18n[lang].description }}</h2>
    <p>{{ training.description[lang] }}</p>
    
    <h2>{{ i18n[lang].prerequisites }}</h2>
    <p>{{ training.prerequisites[lang] }}</p>
    
    <h2>{{ i18n[lang].what_you_will_learn }}</h2>
    <ul class="learning-outcomes">
        {% for outcome in training.learningOutcomes[lang] %}
        <li>{{ outcome }}</li>
        {% endfor %}
    </ul>
</div>

<div class="signup-form">
    <h2>{{ i18n[lang].sign_up_form }}</h2>
    <form action="https://api.example.com/register" method="POST">
        <input type="hidden" name="training_id" value="{{ training.id }}">
        <input type="hidden" name="language" value="{{ lang }}">
        
        <div class="form-group">
            <label for="name">{{ i18n[lang].full_name }} *</label>
            <input type="text" id="name" name="name" required>
        </div>
        
        <div class="form-group">
            <label for="email">{{ i18n[lang].email }} *</label>
            <input type="email" id="email" name="email" required>
        </div>
        
        <div class="form-group">
            <label for="company">{{ i18n[lang].company }}</label>
            <input type="text" id="company" name="company">
        </div>
        
        <div class="form-group">
            <label for="phone">{{ i18n[lang].phone }}</label>
            <input type="tel" id="phone" name="phone">
        </div>
        
        <button type="submit" class="btn">{{ i18n[lang].submit }}</button>
    </form>
</div>
